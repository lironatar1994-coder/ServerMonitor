      "css": ".ds-panel{font-family:var(--sans,'Noto Sans Hebrew',sans-serif);font-variant-numeric:tabular-nums;background:var(--paper-light,#fff);color:var(--ink,#172126);border-top:1px solid var(--line,#BAC8CE);border-radius:0;}.ds-panel h2{margin:0;padding:.65rem 1rem;font-size:1rem;line-height:1.5;border-bottom:1px solid var(--line,#BAC8CE);}.ds-panel div{padding:1rem;font-size:.8rem;color:var(--ink-muted,#43565F);}"
