      "css": ".ds-field{font-family:var(--sans,'Noto Sans Hebrew',sans-serif);font-variant-numeric:tabular-nums;display:grid;gap:.4rem;color:var(--ink-muted,#536479);font-size:.8rem;font-weight:400;}.ds-field input{font-family:var(--sans,'Noto Sans Hebrew',sans-serif);font-variant-numeric:tabular-nums;min-width:0;min-height:44px;padding:.5rem .65rem;border:1px solid var(--line-strong,#93A4B8);border-radius:var(--radius,8px);background:var(--paper-light,#FFFFFF);color:var(--ink,#1D2B3D);font-size:1rem;caret-color:var(--accent,#126B78);}.ds-field input:focus-visible{outline:2px solid var(--accent,#126B78);outline-offset:3px;border-color:var(--accent,#126B78);}"
