    {
      "name": "Data Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "A single subtle boundary around a dataset, with the same structure in graphite infrastructure.",
      "html": "<div class=\"ds-panels\" dir=\"rtl\"><section class=\"ds-panel\"><header><h2>פעילות</h2></header><div class=\"ds-panel-body\">נתונים מופיעים כאן</div></section><section class=\"ds-panel ds-panel-graphite\"><header><h2>צריכת משאבים</h2></header><div class=\"ds-panel-body\">RAM · Swap</div></section></div>",
      "css": ".ds-panels{font-family:var(--sans,'Noto Sans Hebrew',sans-serif);font-variant-numeric:tabular-nums;display:grid;gap:1.25rem;}.ds-panel{background:var(--paper-light,#FFFFFF);color:var(--ink,#1D2B3D);border:1px solid var(--line,#D7E0EA);border-radius:var(--panel-radius,12px);box-shadow:none;overflow:hidden;}.ds-panel header{display:flex;align-items:center;min-height:62px;padding:.8rem 1.1rem;border-bottom:1px solid var(--line,#D7E0EA);}.ds-panel h2{margin:0;font-size:.98rem;line-height:1.5;font-weight:700;}.ds-panel-body{padding:1.1rem;font-size:.8rem;color:var(--ink-muted,#536479);}.ds-panel-graphite{--paper-light:#1A2939;--ink:#EDF3FA;--ink-muted:#B2C0D0;--line:#354B60;}"
    },
