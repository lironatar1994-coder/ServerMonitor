    {
      "name": "Workspace Navigation",
      "kind": "nav",
      "refersTo": "nav-selected",
      "description": "Slate navigation with a clear current destination and named functional icons.",
      "html": "<nav class=\"ds-nav\" dir=\"rtl\" aria-label=\"מעקב\"><span class=\"ds-nav-section\">מעקב</span><a href=\"#visitors\" aria-current=\"page\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20\"/></svg><span>אתרים</span></a><a href=\"#clients\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" aria-hidden=\"true\"><rect width=\"20\" height=\"14\" x=\"2\" y=\"7\" rx=\"2\"/><path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16M2 12a20 20 0 0 0 20 0\"/></svg><span>לקוחות</span></a></nav>",
      "css": ".ds-nav{font-family:var(--sans,'Noto Sans Hebrew',sans-serif);font-variant-numeric:tabular-nums;display:grid;gap:.35rem;background:var(--rail-bg,#192638);padding:1.25rem .85rem;}.ds-nav-section{color:var(--rail-muted,#B9C6D6);padding:0 .75rem .25rem;font-size:.72rem;}.ds-nav a{display:flex;align-items:center;gap:.8rem;min-height:48px;padding:.65rem .8rem;border-radius:var(--radius,8px);color:var(--rail-muted,#B9C6D6);font-size:.9rem;font-weight:400;text-decoration:none;}.ds-nav a:hover{background:#25364B;color:#FFFFFF;}.ds-nav a[aria-current]{background:var(--rail-active,#263D4D);color:#EDF9FA;font-weight:700;}.ds-nav a[aria-current] svg{color:var(--rail-accent,#8AD8DF);}.ds-nav a:focus-visible{outline:2px solid var(--rail-accent,#8AD8DF);outline-offset:3px;}"
