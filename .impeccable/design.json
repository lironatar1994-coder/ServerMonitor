      "css": ".ds-button-primary{font-family:var(--sans,'Noto Sans Hebrew',sans-serif);font-variant-numeric:tabular-nums;min-height:44px;min-width:44px;padding:.5rem .8rem;border:1px solid var(--line,#BAC8CE);border-radius:var(--radius,3px);background:var(--accent,#006775);color:#fff;font-size:.82rem;font-weight:700;cursor:pointer;transition:background .14s ease,border-color .14s ease;}.ds-button-primary:hover{background:#004E59;border-color:var(--ink,#172126);}.ds-button-primary:focus-visible{outline:2px solid var(--accent,#006775);outline-offset:3px;}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
    },
